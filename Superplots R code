##### Script to create a Superplot in R: Using an example from Figure 2- DIV0 and DIV5 area #####

##### required packages #####
library(tidyverse)
library(readxl)
library(ggplot2)
library(ggpubr)
library(ggbeeswarm)
library(ggsignif)

##### import dataframe #####
DIV05_A <- read_excel("/Volumes/Swayne Lab/H9c2Characterization/H9c2MorphologyResults.xlsx") 

##### calculating averages for the Superplot #####
#calculate average per replicate
ReplicateAverages <- DIV05_A %>% 
  group_by(Timepoint, Rep) %>%
  summarise(across(c(`NormalizedArea`), mean))
view(ReplicateAverages)

#calculate average per group (Timepoint)
TotalAverages <- ReplicateAverages %>% 
  summarise(across(c(`NormalizedArea`), mean))
view(TotalAverages)

##### t-test for adding significance to the Superplot #####
#performing a t-test on the means, first calculate the mean per replicate and then the mean of each Timepoint
AreaRep1 <- subset(DIV05_A, Rep == "1") %>% #Calculate mean by group and put it in a new dataframe
  group_by(Timepoint) %>%
  summarise_at(vars(NormalizedArea), list(NormalizedArea = mean))
AreaRep2 <- subset(DIV05_A, Rep == "2") %>%
  group_by(Timepoint) %>%
  summarise_at(vars(NormalizedArea), list(NormalizedArea = mean))
AreaRep3 <- subset(DIV05_A, Rep == "3") %>%
  group_by(Timepoint) %>%
  summarise_at(vars(NormalizedArea), list(NormalizedArea = mean))

AreaReps <- rbind(AreaRep1, AreaRep2, AreaRep3) #merg all means
AreaRepsmean <- AreaReps %>%# Calculate mean by group and put it in a new dataframe
  group_by(Timepoint) %>%
  summarise_at(vars(NormalizedArea), list(NormalizedArea = mean))
print(AreaRepsmean)

Areattest <- t.test(NormalizedArea ~ Timepoint, data = AreaReps)
Areattest #prints output to see result #sumarizes the data from the t-test and will show if any groups are statisically significant
Areapvalues <- Areattest$p.value #extract p-values from the t test


##### graphing Superplot #####
# Variables related to shape display 
mean_point_size = 4 # overall size of the individual datapoint shapes
mean_stroke_size = 0.75 # perimeter around the mean shape 
shape_stroke_size = 0.525 # perimeter around each datapoint shape

#colour code for DIV0 and DIV5
cbPalette <- c("grey95", "#D792FB")
cbPaletteMean <- c("DIV0" = "grey95", "DIV5" = "#AE15F7")

#Superplot
ggplot(DIV05_A, aes(x = Timepoint, y = NormalizedArea)) +
  
  geom_beeswarm(aes(fill = factor(Timepoint), shape = factor(Rep)), color = "black", size = 3, stroke = shape_stroke_size, corral="random") +
  
  # Adds the color inside the shape
  scale_fill_manual(values = cbPalette) +
  
  # Shapes used, note that circle=21, square=22, triangle=24
  scale_shape_manual(values = c(21, 22, 24)) +
  
  # Adds mean values as bars - means for each Timepoint
  stat_summary(data = TotalAverages, aes(group = Timepoint), fun = mean, geom = "crossbar", width = 0.35, color = "black", size=0.4) +
  
  # Adds error bars - error bars for averages by Rep, standard error of the mean
  stat_summary(data = ReplicateAverages, aes(group = Timepoint), fun.data = mean_se, geom = "errorbar", width = 0.5, color = "black", size = 0.6) +
  
  
  # Adds mean points for each rep in each Timepoint
  geom_point(data = ReplicateAverages %>% filter(Timepoint == "DIV5", Rep == 1),
             aes(x = Timepoint, y = NormalizedArea, fill = factor(Timepoint)), shape = 21, size = mean_point_size, stroke = mean_stroke_size, fill = "#AE15F7") +
  
  geom_point(data = ReplicateAverages %>% filter(Timepoint == "DIV5", Rep == 2),
             aes(x = Timepoint, y = NormalizedArea, fill = factor(Timepoint)), shape = 22, size = mean_point_size, stroke = mean_stroke_size, fill = "#AE15F7") +
  
  geom_point(data = ReplicateAverages %>% filter(Timepoint == "DIV5", Rep == 3),
             aes(x = Timepoint, y = NormalizedArea, fill = factor(Timepoint)), shape = 24, size = mean_point_size, stroke = mean_stroke_size, fill = "#AE15F7") +
  
  geom_point(data = ReplicateAverages %>% filter(Timepoint == "DIV0", Rep == 1),
             aes(x = Timepoint, y = NormalizedArea, fill = factor(Timepoint)), shape = 21, size = mean_point_size, stroke = mean_stroke_size, fill = "white") +
  
  geom_point(data = ReplicateAverages %>% filter(Timepoint == "DIV0", Rep == 2),
             aes(x = Timepoint, y = NormalizedArea, fill = factor(Timepoint)), shape = 22, size = mean_point_size, stroke = mean_stroke_size, fill = "white") +
  
  geom_point(data = ReplicateAverages %>% filter(Timepoint == "DIV0", Rep == 3),
             aes(x = Timepoint, y = NormalizedArea, fill = factor(Timepoint)), shape = 24, size = mean_point_size, stroke = mean_stroke_size, fill = "white") +

  # Adds significance to the Superplot
  geom_signif(comparisons = list(c("DIV0", "DIV5")),
              annotation = c("."), textsize = 10,
              test = list(cmp = t.test, p.value = Areapvalues)) +
  # Adds theme for publication, removing background, grids, editing labels
  theme_bw() + 
  theme(axis.line = element_line(colour = "black"),
        legend.position = "none",
        axis.title.y = element_text(family = "Arial", color = "black", vjust = 2),
        axis.text = element_text(family = "Arial", color = "black"),
        axis.ticks = element_line(color = "black"),
        axis.ticks.length = unit(2, "mm"),
        panel.grid.major = element_blank(),
        panel.grid.minor = element_blank(),
        panel.background = element_blank(),
        panel.border = element_blank()) +
  xlab("") + 
  ylab("Area % DIV0")

